{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [],
    "deny": ["EnterPlanMode"],
    "additionalDirectories": [
      "~/.claude/plugins/marketplaces/anthropic-agent-skills",
      "~/.claude/plugins/marketplaces/claude-plugins-official",
      "~/.claude/plugins/marketplaces/superpowers-extended-cc-marketplace"
    ]
  },
  "disableClaudeAiConnectors": true,
  "disableArtifact": true,
  "model": "opus[1m]",
  "effortLevel": "medium",
  "enabledPlugins": {
    "microsoft-docs@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "superpowers-extended-cc@superpowers-extended-cc-marketplace": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "superpowers-extended-cc-marketplace": {
      "source": {
        "source": "github",
        "repo": "pcvelz/superpowers"
      },
      "autoUpdate": false
    }
  }
}
